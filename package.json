{
  "name": "gsapweb",
  "version": "0.1.0",
  "private": true,
  "description": "La casa al final del viento — a scroll-driven 3D narrative experience.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:inspect": "node scripts/inspect-models.mjs",
    "assets:optimize": "node scripts/optimize-models.mjs",
    "assets:validate": "node scripts/validate-models.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run assets:validate && npm run build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@playwright/test": "1.54.2",
    "@types/node": "22.15.21",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "0.24.0",
    "sharp": "0.35.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.0.6",
    "vitest": "3.2.4"
  }
}
